# Flask Application Secret Key
SECRET_KEY=replace_with_a_secure_random_flask_secret_key

# MySQL Database Connection String
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/skillsprint_ai

# Clerk JWT Verification (Required for authenticated endpoints)
# Set your Clerk JWKS endpoint URL from your Clerk Dashboard (API Keys > Frontend API):
# Example: https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-subdomain.clerk.accounts.dev/.well-known/jwks.json

# Alternative Authentication Key Options (Optional)
# If using a local RS256 PEM public key instead of remote JWKS:
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"
# If specifying Clerk Frontend API domain directly:
# CLERK_FRONTEND_API=your-clerk-subdomain.clerk.accounts.dev

# Optional Token Claim Validations
# CLERK_ISSUER=https://your-clerk-subdomain.clerk.accounts.dev
# CLERK_AUDIENCE=your_clerk_audience
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5174

